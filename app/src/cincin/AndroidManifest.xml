        android:name="id.bram.cincinlangkah.permission.READ_DATA"
        android:protectionLevel="signature" />
    <application>
        <provider
            android:name="id.bram.cincinlangkah.RingProvider"
            android:authorities="id.bram.cincinlangkah.data"
            android:exported="true"
            android:readPermission="id.bram.cincinlangkah.permission.READ_DATA" />
    </application>
</manifest>
